---
interface CaseItem {
  label: string;
  title: string;
  subtitle: string;
  summary: string;
  role: string;
  outcome: string;
  href: string;
  tags: string[];
}
interface Props { item: CaseItem }
import { withBase } from "../lib/paths";
const { item } = Astro.props;
---
<a class="project-card" href={withBase(item.href)}>
  <div>
    <div class="case-index">{item.label}</div>
    <h3>{item.title}</h3>
    <h4>{item.subtitle}</h4>
    <p>{item.summary}</p>
    <p class="card-outcome" style="margin-top:14px"><strong>Role:</strong> {item.role}</p>
    <p class="card-outcome" style="margin-top:8px"><strong>Proof:</strong> {item.outcome}</p>
  </div>
</a>
