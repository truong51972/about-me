---
interface CaseItem {
  label: string;
  title: string;
  subtitle: string;
  summary: string;
  role: string;
  outcome: string;
  href: string;
  tags: string[];
}
interface Props { item: CaseItem }
const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class="case-card" href={`${base}${item.href}`}>
  <div>
    <div class="case-index">{item.label}</div>
    <h3>{item.title}</h3>
    <h4>{item.subtitle}</h4>
    <p>{item.summary}</p>
    <p style="margin-top:14px"><strong style="color:var(--text)">Role:</strong> {item.role}</p>
    <p style="margin-top:8px"><strong style="color:var(--text)">Proof:</strong> {item.outcome}</p>
  </div>
  <div class="tag-row">
    {item.tags.slice(0, 6).map((tag) => <span class="tag">{tag}</span>)}
  </div>
</a>
