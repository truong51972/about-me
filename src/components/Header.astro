---
import { withBase } from "../lib/paths";
import { site } from "../data/profile";
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={withBase()} aria-label="Home">
      <span class="brand-mark">TQ</span>
      <span>
        <span class="brand-name">{site.name}</span>
      </span>
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      <a href={withBase("#top")}>Overview</a>
      <a href={withBase("#projects")}>Projects</a>
      <a href={withBase("#experience")}>Experience</a>
      <a href={withBase("#skills")}>Skills</a>
    </nav>
    <div class="nav-actions">
      <a class="nav-email" href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</header>
