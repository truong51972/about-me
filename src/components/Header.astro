---
import { withBase } from "../lib/paths";
import { site } from "../data/profile";
---
<header class="fixed top-0 left-0 w-full z-50 glass-panel border-x-0 border-t-0 shadow-lg shadow-black/20">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl h-16 flex items-center justify-between">
    <a class="flex items-center gap-3 text-white hover:text-brand-400 transition-colors" href={withBase()} aria-label="Home">
      <span class="flex items-center justify-center w-8 h-8 rounded-md bg-brand-500 text-white font-bold text-sm">
        {site.shortName || "TQT"}
      </span>
      <span class="font-semibold hidden sm:block">
        {site.name}
      </span>
    </a>
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-text-muted" aria-label="Main navigation">
      <a class="hover:text-white transition-colors" href={withBase("#top")}>Overview</a>
      <a class="hover:text-white transition-colors" href={withBase("#projects")}>Projects</a>
      <a class="hover:text-white transition-colors" href={withBase("#experience")}>Experience</a>
      <a class="hover:text-white transition-colors" href={withBase("#education-skills")}>Skills</a>
    </nav>
    <div class="flex items-center gap-4">
      <a class="text-sm font-semibold text-brand-400 hover:text-brand-300 transition-colors" href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</header>
