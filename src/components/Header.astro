---
import { withBase } from "../lib/paths";
import { site } from "../data/profile";
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={withBase()} aria-label="Home">
      <span class="brand-mark">TQ</span>
      <span>
        <span class="brand-name">{site.name}</span>
        <span class="brand-sub">{site.tagline}</span>
      </span>
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      <a href={withBase("#work")}>Work</a>
      <a href={withBase("projects/")}>Projects</a>
      <a href={withBase("#decisions")}>Decisions</a>
      <a href={withBase("cv/")}>CV</a>
    </nav>
    <div class="nav-actions">
      <a class="pill-link" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="btn small primary" href={`mailto:${site.email}`}>Contact</a>
    </div>
  </div>
</header>
