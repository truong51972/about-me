---
import { withBase } from "../lib/paths";
import { site } from "../data/profile";
---
<header class="fixed left-0 top-0 z-50 w-full border-b border-white/10 bg-bg-base/82 backdrop-blur-xl">
  <div class="site-shell flex h-16 items-center justify-between gap-5">
    <a class="flex min-w-0 items-center gap-3 text-white hover:text-brand-300" href={withBase()} aria-label="Home">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-brand-300/25 bg-brand-500/15 text-sm font-bold text-brand-300">
        {site.shortName || "TQT"}
      </span>
      <span class="hidden truncate text-sm font-semibold sm:block">
        {site.name}
      </span>
    </a>
    <nav class="hidden items-center gap-7 whitespace-nowrap text-sm font-medium text-text-muted md:flex" aria-label="Main navigation">
      <a class="hover:text-white" href={withBase("#top")}>Overview</a>
      <a class="hover:text-white" href={withBase("#projects")}>Projects</a>
      <a class="hover:text-white" href={withBase("#experience")}>Experience</a>
      <a class="hover:text-white" href={withBase("#education-skills")}>Skills</a>
    </nav>
    <div class="flex shrink-0 items-center gap-4">
      <a class="rounded-lg border border-white/10 bg-white/[0.045] px-3.5 py-2 text-sm font-semibold text-white hover:border-brand-400/35 hover:bg-white/[0.08]" href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</header>
