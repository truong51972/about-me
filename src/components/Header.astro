---
import { withBase } from "../lib/paths";
import { site } from "../data/profile";
---

<header class="fixed left-0 top-0 z-50 w-full border-b border-[var(--border-subtle)] bg-[var(--nav-bg)] backdrop-blur-xl transition-colors duration-200">
  <div class="site-shell flex h-16 items-center justify-between gap-5">
    <a
      class="group flex min-w-0 items-center gap-3 text-[var(--text-base)] transition-colors duration-200 hover:text-sky-600 dark:hover:text-sky-400"
      href={withBase()}
      aria-label="Home"
    >
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-sky-500/25 bg-sky-500/10 text-sm font-bold text-sky-700 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
        {site.shortName || "TQT"}
      </span>
      <span class="hidden truncate text-sm font-semibold sm:block">
        {site.name}
      </span>
    </a>

    <nav class="hidden items-center gap-7 whitespace-nowrap text-sm font-medium text-[var(--text-muted)] md:flex" aria-label="Main navigation">
      <a class="transition-colors hover:text-[var(--text-base)]" href={withBase("#top")}>Overview</a>
      <a class="transition-colors hover:text-[var(--text-base)]" href={withBase("#featured-work")}>Featured Work</a>
      <a class="transition-colors hover:text-[var(--text-base)]" href={withBase("#what-i-build")}>What I Build</a>
      <a class="transition-colors hover:text-[var(--text-base)]" href={withBase("#experience")}>Experience</a>
      <a class="transition-colors hover:text-[var(--text-base)]" href={withBase("#skills")}>Skills</a>
      <a class="transition-colors hover:text-[var(--text-base)]" href={withBase("#honors")}>Honors</a>
      <a class="transition-colors hover:text-[var(--text-base)]" href={withBase("cv/")}>CV</a>
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      {/* Theme Toggle Button */}
      <button
        id="theme-toggle-btn"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--card-bg)] text-[var(--text-muted)] transition hover:border-sky-500/40 hover:text-[var(--text-base)]"
        aria-label="Toggle theme"
      >
        {/* Sun Icon (displayed in dark mode) */}
        <svg id="theme-sun-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        {/* Moon Icon (displayed in light mode) */}
        <svg id="theme-moon-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>

      <a
        class="inline-flex min-h-9 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--card-bg)] px-3.5 py-1.5 text-sm font-semibold text-[var(--text-base)] shadow-sm transition hover:border-sky-500/40 hover:bg-[var(--bg-subtle)]"
        href={`mailto:${site.email}`}
      >
        Email
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById("theme-toggle-btn");
    const sunIcon = document.getElementById("theme-sun-icon");
    const moonIcon = document.getElementById("theme-moon-icon");

    function updateIcons() {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        sunIcon?.classList.remove("hidden");
        moonIcon?.classList.add("hidden");
      } else {
        sunIcon?.classList.add("hidden");
        moonIcon?.classList.remove("hidden");
      }
    }

    updateIcons();

    if (btn) {
      btn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark");
        if (isDark) {
          document.documentElement.classList.remove("dark");
          localStorage.setItem("theme", "light");
        } else {
          document.documentElement.classList.add("dark");
          localStorage.setItem("theme", "dark");
        }
        updateIcons();
      });
    }
  })();
</script>
