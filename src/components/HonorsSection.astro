---
import { withBase } from "../lib/paths";
import { achievements } from "../data/profile";
---

<section class="py-20 md:py-24" id="honors">
  <div class="site-shell">
    <div class="mb-10">
      <h2 class="text-3xl font-bold tracking-tight text-[var(--text-primary)] md:text-4xl">
        Honors & Awards
      </h2>
      <p class="mt-3 text-base text-[var(--text-secondary)]">
        Recognition in competitive hackathons and academic research.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {achievements.map((item) => (
        <article class="bento-card flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3">
              <span class="inline-flex items-center rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
                {item.badge}
              </span>
              <span class="font-mono text-xs text-[var(--text-muted)]">
                {item.period}
              </span>
            </div>

            <h3 class="text-xl font-bold text-[var(--text-primary)]">
              {item.title}
            </h3>

            <p class="mt-1 text-sm font-medium text-sky-700 dark:text-sky-400">
              {item.org} {item.team && `· ${item.team}`}
            </p>

            <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
              {item.description}
            </p>

            {/* Photos List */}
            <div class={`mt-5 grid gap-3 ${item.images.length > 1 ? "grid-cols-2" : "grid-cols-1"}`}>
              {item.images.map((img) => (
                <figure
                  class="group relative cursor-pointer overflow-hidden rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)] transition hover:border-sky-500/40"
                  data-lightbox-trigger
                  data-image-src={withBase(img.src)}
                  data-image-alt={img.alt}
                  data-image-caption={img.caption}
                  tabindex="0"
                  role="button"
                  aria-label={`View image: ${img.alt}`}
                >
                  <div class="aspect-[4/3] w-full overflow-hidden bg-slate-900/5 dark:bg-slate-900/40">
                    <img
                      src={withBase(img.src)}
                      alt={img.alt}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    />
                  </div>
                  <figcaption class="p-2 text-[11px] leading-tight text-[var(--text-muted)]">
                    {img.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>

          {item.projectSlug && (
            <div class="mt-6 border-t border-[var(--border-subtle)] pt-4">
              <a
                href={withBase(`projects/${item.projectSlug}/`)}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200"
              >
                <span>{item.projectLabel ?? "View case study"}</span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>

  {/* Accessible Lightbox Modal */}
  <div
    id="honors-lightbox"
    class="fixed inset-0 z-50 flex hidden items-center justify-center bg-slate-950/85 p-4 backdrop-blur-sm transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-label="Image Preview"
  >
    <div class="relative max-h-[90vh] max-w-3xl overflow-hidden rounded-xl border border-white/20 bg-slate-900 shadow-2xl">
      <button
        id="lightbox-close"
        class="absolute right-3 top-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/70 text-white transition hover:bg-black"
        aria-label="Close image preview"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div id="lightbox-image-container" class="flex min-h-[260px] items-center justify-center p-2"></div>
      <div class="border-t border-white/10 bg-slate-950 p-3 text-center">
        <p id="lightbox-caption" class="text-xs font-medium text-slate-300"></p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const lightbox = document.getElementById("honors-lightbox");
    const container = document.getElementById("lightbox-image-container");
    const lightboxCaption = document.getElementById("lightbox-caption");
    const closeBtn = document.getElementById("lightbox-close");
    const triggers = document.querySelectorAll("[data-lightbox-trigger]");

    if (!lightbox || !container || !lightboxCaption) return;

    function openLightbox(src, alt, caption) {
      container.innerHTML = `<img src="${src}" alt="${alt}" class="max-h-[75vh] w-auto object-contain mx-auto rounded" />`;
      lightboxCaption.textContent = caption || alt;
      lightbox.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      container.innerHTML = "";
      document.body.style.overflow = "";
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const src = trigger.getAttribute("data-image-src");
        const alt = trigger.getAttribute("data-image-alt") || "";
        const caption = trigger.getAttribute("data-image-caption") || "";
        if (src) openLightbox(src, alt, caption);
      });

      trigger.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const src = trigger.getAttribute("data-image-src");
          const alt = trigger.getAttribute("data-image-alt") || "";
          const caption = trigger.getAttribute("data-image-caption") || "";
          if (src) openLightbox(src, alt, caption);
        }
      });
    });

    if (closeBtn) closeBtn.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !lightbox.classList.contains("hidden")) closeLightbox();
    });
  })();
</script>
