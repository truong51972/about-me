---
import { site } from "../data/profile";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-row">
    <div>
      <strong>{site.name}</strong>
      <div>{site.tagline}</div>
    </div>
    <div class="footer-links">
      <a class="btn small ghost" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="btn small ghost" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="btn small ghost" href={`mailto:${site.email}`}>Email</a>
    </div>
    <div>© {year}</div>
  </div>
</footer>
