---
import { site } from "../data/profile";
const year = new Date().getFullYear();
---
<footer class="bg-bg-base border-t border-white/5 py-12">
  <div class="container mx-auto px-6 lg:px-8 max-w-5xl flex flex-col md:flex-row items-center md:items-start justify-between gap-8 text-center md:text-left">
    <div>
      <strong class="block text-white text-lg mb-1">{site.name}</strong>
      <div class="text-sm text-text-muted">{site.role}</div>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a class="text-sm font-medium text-text-muted hover:text-white transition-colors" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="text-sm font-medium text-text-muted hover:text-white transition-colors" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="text-sm font-medium text-text-muted hover:text-white transition-colors" href={`mailto:${site.email}`}>Email</a>
    </div>
    <div class="text-sm text-text-muted/60">© {year} All rights reserved.</div>
  </div>
</footer>
