---
import { site } from "../data/profile";
const year = new Date().getFullYear();
---
<footer class="border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-12 transition-colors">
  <div class="site-shell grid gap-8 md:grid-cols-[minmax(0,1.2fr)_auto] md:items-end">
    <div class="max-w-2xl">
      <strong class="mb-2 block text-lg font-bold text-[var(--text-primary)]">{site.name}</strong>
      <div class="text-sm leading-relaxed text-[var(--text-secondary)]">{site.role}</div>
      <div class="mt-2 text-xs text-[var(--text-muted)]">{site.location}</div>
    </div>
    <div class="flex flex-col gap-4 md:items-end">
      <div class="flex flex-wrap gap-2.5">
        <a class="btn-secondary px-3.5 py-1.5 text-xs font-semibold" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a class="btn-secondary px-3.5 py-1.5 text-xs font-semibold" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a class="btn-secondary px-3.5 py-1.5 text-xs font-semibold" href={`mailto:${site.email}`}>Email</a>
      </div>
      <div class="text-xs text-[var(--text-muted)]">© {year} {site.name}. All rights reserved.</div>
    </div>
  </div>
</footer>
