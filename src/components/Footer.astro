---
import { site } from "../data/profile";
const year = new Date().getFullYear();
---
<footer class="border-t border-white/10 py-14">
  <div class="site-shell grid gap-10 md:grid-cols-[minmax(0,1.2fr)_auto] md:items-end">
    <div class="max-w-2xl">
      <strong class="mb-3 block text-xl font-semibold text-white">{site.name}</strong>
      <div class="text-sm leading-7 text-text-muted">{site.role}</div>
      <div class="mt-4 text-sm text-text-muted/70">{site.location}</div>
    </div>
    <div class="flex flex-col gap-5 md:items-end">
      <div class="flex flex-wrap gap-3">
        <a class="btn-secondary px-4 py-2" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
        <a class="btn-secondary px-4 py-2" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="btn-secondary px-4 py-2" href={`mailto:${site.email}`}>Email</a>
      </div>
      <div class="text-sm text-text-muted/60">© {year} All rights reserved.</div>
    </div>
  </div>
</footer>
