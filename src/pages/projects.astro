---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import { cases, type ProjectGroup } from "../data/profile";

const projectHref = (slug: string) => withBase(`projects/${slug}/`);

const groups: Array<{ id: ProjectGroup; title: string; summary: string }> = [
  {
    id: "featured-systems",
    title: "Featured systems",
    summary:
      "The strongest evidence of Product Engineering, backend architecture, and Applied AI delivery."
  },
  {
    id: "applied-ai-systems",
    title: "Applied AI systems",
    summary:
      "Products and prototypes combining models, retrieval, agent workflows, and user-facing software."
  },
  {
    id: "quality-delivery",
    title: "Quality Engineering delivery",
    summary:
      "Enterprise automation, transaction validation, and quality-analysis work across complex systems."
  },
  {
    id: "engineering-foundations",
    title: "Engineering foundations",
    summary:
      "Earlier full-stack and machine-learning projects that established the foundation for the current direction."
  }
];

const projectImages: Record<string, string> = {
  iqp: "images/project-iqp-panel.jpg",
  "omni-agent": "images/project-omni-panel.png",
  ata: "images/project-ata-panel.png",
  apit: "images/project-apit-panel.png",
  lms: "images/project-lms-panel.jpg",
  "self-driving-car": "images/project-vision-panel.png",
  "plant-disease-detection": "images/project-vision-panel.png"
};

const tierClass = {
  flagship: "xl:col-span-2",
  featured: "",
  supporting: "",
  compact: ""
};
---

<BaseLayout title="Projects" description="Applied AI, backend, evaluation, and computer-vision projects by Tran Quoc Truong.">
  <section class="relative overflow-hidden border-b border-white/10 pb-16 pt-28 md:pb-24 md:pt-36">
    <div class="site-shell relative z-10">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <div class="eyebrow mb-6">Projects</div>
          <h1 class="max-w-5xl text-4xl font-semibold leading-tight text-white md:text-6xl">
            Projects
          </h1>
          <p class="measure mt-7 text-2xl font-medium leading-tight text-brand-300">
            Products, platforms, and engineering systems.
          </p>
          <p class="measure mt-4 text-base leading-7 text-text-muted/80">
            Omni-Agent is the flagship Applied AI platform. IQP demonstrates enterprise Quality Engineering delivery, while the remaining projects show banking automation, model development, and earlier Product Engineering foundations.
          </p>
        </div>
        <div class="grid grid-cols-3 gap-3 lg:col-span-4">
          <div class="surface-panel rounded-xl p-4">
            <div class="font-mono text-3xl font-semibold text-white">{cases.length}</div>
            <div class="mt-1 text-xs leading-5 text-text-muted">case studies</div>
          </div>
          <div class="surface-panel rounded-xl p-4">
            <div class="font-mono text-3xl font-semibold text-white">{groups.length}</div>
            <div class="mt-1 text-xs leading-5 text-text-muted">evidence groups</div>
          </div>
          <div class="surface-panel rounded-xl p-4">
            <div class="font-mono text-3xl font-semibold text-white">{cases.filter((item) => item.group === "featured-systems").length}</div>
            <div class="mt-1 text-xs leading-5 text-text-muted">featured systems</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="site-shell space-y-20">
      {groups.map((group) => {
        const groupCases = cases.filter((item) => item.group === group.id);
        if (groupCases.length === 0) return null;
        return (
          <section class="grid gap-8 lg:grid-cols-12">
            <div class="lg:col-span-3">
              <div class="lg:sticky lg:top-24">
                <h2 class="text-2xl font-semibold text-white">{group.title}</h2>
                <p class="mt-4 leading-7 text-text-muted">{group.summary}</p>
                <div class="mt-6 font-mono text-sm text-brand-300">{groupCases.length} entries</div>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-2 lg:col-span-9">
              {groupCases.map((item) => (
                <a class={`group block ${tierClass[item.visualTier]}`} href={projectHref(item.slug)}>
                  <article class="project-card">
                    {projectImages[item.slug] && (
                      <div class="project-art mb-6">
                        <img src={withBase(projectImages[item.slug])} alt={`${item.title} abstract technical panel`} loading="lazy" />
                      </div>
                    )}
                    <div class="mb-5 flex flex-wrap items-center gap-2">
                      <span class="tag border-brand-400/20 bg-brand-400/10 text-brand-300">{item.label}</span>
                      {item.period && <span class="tag">{item.period}</span>}
                    </div>
                    <h3>{item.title}</h3>
                    <p class="mt-3 text-sm font-medium text-brand-300/85">{item.subtitle}</p>
                    <div class="mt-5 flex-grow space-y-4">
                      <p>{item.summary}</p>
                      {item.outcome && (
                        <p class="rounded-xl border-l-2 border-brand-500 bg-white/[0.045] p-4 text-sm">
                          <strong class="text-white">Outcome:</strong> {item.outcome}
                        </p>
                      )}
                    </div>
                    <div class="mt-7 flex flex-wrap gap-2">
                      {item.tags.slice(0, item.visualTier === "flagship" ? 9 : 6).map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  </article>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>
