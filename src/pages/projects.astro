---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import { cases } from "../data/profile";
---
<BaseLayout title="Projects" description="Selected projects by Tran Quoc Truong." >
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Projects</div>
      <h1>Selected work across AI agent systems, evaluation, and automation.</h1>
      <p class="page-summary">Omni-Agent is the flagship AI Agent Hub. APIT demonstrates LLM evaluation and fine-tuning with agent testing methodology. Banking QA shows industry delivery. Self-driving Car is earlier award-winning research.</p>
    </div>
  </section>
  <section class="section tight">
    <div class="container">
      <div class="card-grid two">
        {cases.map((item) => {
          const CardComponent = item.slug === "self-driving-car" ? "div" : "a";
          const href = item.slug === "self-driving-car" ? undefined : withBase(item.href);
          const extraClass = item.slug === "self-driving-car" ? " card-earlier" : "";
          return (
            <CardComponent class={"case-card" + extraClass} href={href}>
              <div class="case-card-label">{item.label}</div>
              <h3 class="case-card-title">{item.title}</h3>
              <p class="case-card-sub">{item.subtitle}</p>
              <p class="case-card-desc">{item.summary}</p>
              <div class="case-card-stat">{item.outcome}</div>
              <div class="project-card-stack" style="margin-top:10px">
                {item.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </CardComponent>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>