---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseCard from "../components/CaseCard.astro";
import { cases } from "../data/profile";
---
<BaseLayout title="Projects" description="Selected case studies by Tran Quoc Truong." >
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Case studies</div>
      <h1>Projects structured around context, decisions, and proof.</h1>
      <p class="page-summary">The order is intentional: Omni-Agent is the flagship systems case, APIT is the AI capstone and LLM evaluation proof, Banking QA is industry delivery proof, and Self-driving Car Problem is earlier award-winning AI research.</p>
    </div>
  </section>
  <section class="section tight">
    <div class="container">
      <div class="card-grid two">
        {cases.map((item) => <CaseCard item={item} />)}
      </div>
    </div>
  </section>
</BaseLayout>