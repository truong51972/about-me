---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, timeline, achievements, education, skillGroups, cases, type ProjectCase } from "../data/profile";

const pdfPath = withBase("cv/Tran_Quoc_Truong_CV.pdf");
const htmlPath = withBase("cv/Tran_Quoc_Truong_CV.html");
const yamlPath = withBase("Tran_Quoc_Truong_CV.yaml");
const mdPath = withBase("cv/Tran_Quoc_Truong_CV.md");
const cvProjectSlugs = [
  "omni-agent",
  "iqp",
  "banking-automation",
  "apit"
];
const cvProjects = cvProjectSlugs
  .map((slug) => cases.find((item) => item.slug === slug))
  .filter((item): item is ProjectCase => Boolean(item));
---

<BaseLayout title="CV" description="CV summary for Tran Quoc Truong.">
  <section class="border-b border-[var(--border-subtle)] pb-16 pt-28 md:pb-24 md:pt-36">
    <div class="site-shell">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <h1 class="text-4xl font-bold tracking-tight text-[var(--text-base)] md:text-6xl">{site.name}</h1>
          <p class="measure mt-4 text-xl leading-relaxed text-[var(--text-muted)]">{site.role}. {site.summary}</p>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
          <a class="btn-primary" href={pdfPath} target="_blank" rel="noreferrer">Download PDF</a>
          <a class="btn-secondary" href={htmlPath} target="_blank" rel="noreferrer">Open HTML</a>
          <a class="btn-secondary" href={yamlPath} target="_blank" rel="noreferrer">YAML Source</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="site-shell grid gap-10 lg:grid-cols-[20rem_minmax(0,1fr)] xl:grid-cols-[22rem_minmax(0,1fr)]">
      <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
        <div class="evidence-card">
          <h3>Contact</h3>
          <p>{site.location}</p>
          <p class="mt-3"><a class="text-sky-600 hover:text-sky-700 dark:text-sky-400" href={`mailto:${site.email}`}>{site.email}</a></p>
          <p class="mt-3"><a class="text-sky-600 hover:text-sky-700 dark:text-sky-400" href={site.github} target="_blank" rel="noreferrer">GitHub</a></p>
          <p class="mt-3"><a class="text-sky-600 hover:text-sky-700 dark:text-sky-400" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></p>
        </div>

        <div class="evidence-card">
          <h3>Downloads</h3>
          <div class="grid gap-2">
            <a class="btn-secondary justify-start px-4 py-2" href={pdfPath} target="_blank" rel="noreferrer">PDF</a>
            <a class="btn-secondary justify-start px-4 py-2" href={mdPath} target="_blank" rel="noreferrer">Markdown</a>
            <a class="btn-secondary justify-start px-4 py-2" href={htmlPath} target="_blank" rel="noreferrer">HTML</a>
            <a class="btn-secondary justify-start px-4 py-2" href={yamlPath} target="_blank" rel="noreferrer">YAML Source</a>
          </div>
        </div>
      </aside>

      <article class="space-y-16">
        <section class="surface-panel rounded-2xl p-6 md:p-8">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-3">Positioning</h2>
          <h3 class="max-w-4xl text-2xl font-bold leading-tight text-[var(--text-base)] md:text-3xl">
            Solution-oriented Applied AI Engineer translating business and operational problems into reliable systems.
          </h3>
          <p class="measure mt-4 text-base leading-relaxed text-[var(--text-muted)]">
            {site.about}
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold leading-tight text-[var(--text-base)] mb-6">Experience</h2>
          <div class="space-y-5">
            {timeline.map((item) => (
              <article class="bento-card">
                <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_12rem]">
                  <div>
                    <h3>{item.title}</h3>
                    <p class="mt-1 text-sm font-semibold text-sky-700 dark:text-sky-400">{item.org}</p>
                  </div>
                  <p class="font-mono text-xs text-[var(--text-muted)] md:text-right">{item.period}</p>
                </div>
                <ul class="mt-6 grid gap-3 text-xs leading-relaxed text-[var(--text-muted)] md:grid-cols-2 md:text-sm">
                  {item.bullets.map((bullet) => (
                    <li class="border-t border-[var(--border-subtle)] pt-3">{bullet}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-bold leading-tight text-[var(--text-base)] mb-6">Honors & Achievements</h2>
          <div class="space-y-5">
            {achievements.map((item) => (
              <article class="bento-card">
                <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_12rem]">
                  <div>
                    <div class="mb-2 flex items-center gap-2">
                      <span class="inline-flex rounded-full border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-700 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
                        {item.badge}
                      </span>
                    </div>
                    <h3>{item.title}</h3>
                    <p class="mt-1 text-sm font-semibold text-sky-700 dark:text-sky-400">{item.org} {item.team && `· ${item.team}`}</p>
                  </div>
                  <p class="font-mono text-xs text-[var(--text-muted)] md:text-right">{item.period}</p>
                </div>
                <p class="mt-4 border-t border-[var(--border-subtle)] pt-3 text-sm leading-relaxed text-[var(--text-muted)]">{item.description}</p>
                {item.projectSlug && (
                  <p class="mt-3 text-xs font-medium">
                    <a class="text-sky-600 hover:text-sky-700 dark:text-sky-400 font-semibold" href={withBase(`projects/${item.projectSlug}/`)}>
                      → {item.projectLabel ?? "View associated case study"}
                    </a>
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-bold leading-tight text-[var(--text-base)] mb-6">Selected Projects</h2>
          <div class="grid gap-5 md:grid-cols-2">
            {cvProjects.map((item) => (
              <a class="group block" href={withBase(`projects/${item.slug}/`)}>
                <article class="bento-card h-full">
                  <p class="font-mono text-xs text-sky-700 dark:text-sky-400">{item.period}</p>
                  <h3 class="mt-2 group-hover:text-sky-600 dark:group-hover:text-sky-400">{item.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{item.summary}</p>
                </article>
              </a>
            ))}
          </div>
        </section>
      </article>
    </div>
  </section>

  <section class="border-t border-[var(--border-subtle)] bg-[var(--bg-subtle)]/25 py-16 md:py-24">
    <div class="site-shell">
      <div class="mb-10 max-w-3xl">
        <h2 class="text-3xl font-bold leading-tight text-[var(--text-base)]">Technical Skills</h2>
        <p class="mt-2 text-base text-[var(--text-muted)]">
          Technical capabilities supporting solution design, implementation, integration, and reliability.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
        {skillGroups.map((group) => (
          <article class="bento-card">
            <h3 class="min-h-12 text-base">{group.title}</h3>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--border-subtle)] py-16 md:py-24">
    <div class="site-shell">
      <div class="mb-10 max-w-3xl">
        <h2 class="text-3xl font-bold leading-tight text-[var(--text-base)]">Education</h2>
        <p class="mt-2 text-base text-[var(--text-muted)]">
          Formal software engineering and artificial intelligence training.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {education.map((item) => (
          <article class="bento-card">
            <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_12rem]">
              <div>
                <p class="text-sm font-semibold text-sky-700 dark:text-sky-400">{item.org}</p>
                <h3 class="mt-1 text-xl font-semibold text-[var(--text-base)]">{item.degree}</h3>
              </div>
              <p class="font-mono text-xs text-[var(--text-muted)] md:text-right">{item.period}</p>
            </div>
            {item.note && <p class="mt-4 border-t border-[var(--border-subtle)] pt-3 text-sm text-[var(--text-muted)]">{item.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--border-subtle)] bg-[var(--bg-subtle)]/25 py-16 md:py-24">
    <div class="site-shell">
      <div class="mb-10 max-w-3xl">
        <h2 class="text-3xl font-bold leading-tight text-[var(--text-base)]">Languages</h2>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <article class="bento-card">
          <h3>Vietnamese</h3>
          <p class="mt-2 text-sm text-[var(--text-muted)]">Native</p>
        </article>
        <article class="bento-card">
          <h3>English</h3>
          <p class="mt-2 text-sm text-[var(--text-muted)]">Working proficiency</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
