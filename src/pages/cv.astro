---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import TimelineItem from "../components/TimelineItem.astro";
import { site, timeline, education, skillGroups, cases } from "../data/profile";
const pdfPath = withBase("cv/Tran_Quoc_Truong_CV.pdf");
const htmlPath = withBase("cv/Tran_Quoc_Truong_CV.html");
const yamlPath = withBase("Tran_Quoc_Truong_CV.yaml");
const mdPath = withBase("cv/Tran_Quoc_Truong_CV.md");
const cvProjectSlugs = ["omni-agent", "ata", "apit"];
const cvProjects = cases.filter((item) => cvProjectSlugs.includes(item.slug));
---
<BaseLayout title="CV" description="CV summary for Tran Quoc Truong." >
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="case-index">CV</div>
      <h1>{site.name}</h1>
      <p class="page-summary">{site.role}. {site.summary}</p>
      <div class="hero-actions">
        <a class="btn primary" href={pdfPath} target="_blank" rel="noreferrer">Download CV PDF</a>
        <a class="btn ghost" href={htmlPath} target="_blank" rel="noreferrer">Open HTML CV</a>
        <a class="btn ghost" href={yamlPath} target="_blank" rel="noreferrer">View YAML source</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container content-grid">
      <article class="article">
        <section class="block">
          <div class="eyebrow">Positioning</div>
          <h2>Applied AI Backend Engineer focused on Python systems, retrieval, evaluation, and machine learning services.</h2>
          <p>My profile combines backend engineering, applied AI systems, and agent evaluation, building workflows where AI outputs become traceable, auditable, and testable product behavior.</p>
        </section>

        <section class="block">
          <div class="eyebrow">Experience</div>
          <div class="timeline">
            {timeline.map((item) => <TimelineItem item={item} />)}
          </div>
        </section>

        <section class="block">
          <div class="eyebrow">Selected projects</div>
          <h2>Projects</h2>
          <ul class="clean">
            {cvProjects.map((item) => <li><strong>{item.title}</strong> - {item.summary}</li>)}
          </ul>
        </section>
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h3>Contact</h3>
          <p>{site.location}</p>
          <p class="side-card-link"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div class="side-card">
          <h3>Education</h3>
          {education.map((item) => (
            <div class="side-card-section">
              <strong>{item.degree}</strong>
              <p>{item.org}</p>
              <p>{item.period}</p>
            </div>
          ))}
        </div>
        <div class="side-card">
          <h3>Download</h3>
          <ul class="clean link-list">
            <li><a href={pdfPath} target="_blank" rel="noreferrer">PDF</a></li>
            <li><a href={mdPath} target="_blank" rel="noreferrer">Markdown</a></li>
            <li><a href={htmlPath} target="_blank" rel="noreferrer">HTML</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="skill-list">
        {skillGroups.map((group) => (
          <div class="skill-list-group">
            <h3>{group.title}</h3>
            <div class="skill-items">
              {group.items.map((item) => <span class="tag">{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
