---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import TimelineItem from "../components/TimelineItem.astro";
import { site, timeline, education, skillGroups, cases } from "../data/profile";
const pdfPath = withBase("cv/Tran_Quoc_Truong_CV.pdf");
const htmlPath = withBase("cv/Tran_Quoc_Truong_CV.html");
const yamlPath = withBase("Tran_Quoc_Truong_CV.yaml");
const mdPath = withBase("cv/Tran_Quoc_Truong_CV.md");
---
<BaseLayout title="CV" description="CV summary for Tran Quoc Truong." >
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="case-index">CV</div>
      <h1>{site.name}</h1>
      <p class="page-summary">{site.role} · {site.tagline}.</p>
      <div class="hero-actions">
        <a class="btn primary" href={pdfPath} target="_blank" rel="noreferrer">Download CV PDF</a>
        <a class="btn ghost" href={htmlPath} target="_blank" rel="noreferrer">Open HTML CV</a>
        <a class="btn ghost" href={yamlPath} target="_blank" rel="noreferrer">View YAML source</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container content-grid">
      <article class="article">
        <section class="block">
          <div class="eyebrow">Positioning</div>
          <h2>Applied AI Engineer focused on RAG systems, Agentic QA, and Python backend.</h2>
          <p>My profile combines AI workflow design with backend engineering and QA automation, building systems where AI outputs become traceable product workflows.</p>
        </section>

        <section class="block">
          <div class="eyebrow">Experience</div>
          <div class="timeline">
            {timeline.map((item) => <TimelineItem item={item} />)}
          </div>
        </section>

        <section class="block">
          <div class="eyebrow">Selected projects</div>
          <h2>Projects</h2>
          <ul class="clean">
            {cases.map((item) => <li><strong style="color:var(--text)">{item.title}</strong> — {item.summary}</li>)}
          </ul>
        </section>
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h3>Contact</h3>
          <p>{site.location}</p>
          <p style="margin-top:8px"><a href={`mailto:${site.email}`} style="color:var(--accent)">{site.email}</a></p>
        </div>
        <div class="side-card">
          <h3>Education</h3>
          {education.map((item) => (
            <div style="border-top:1px solid var(--line);padding-top:12px;margin-top:12px">
              <strong>{item.degree}</strong>
              <p>{item.org}</p>
              <p>{item.period}</p>
            </div>
          ))}
        </div>
        <div class="side-card">
          <h3>Download</h3>
          <ul class="clean" style="display:grid;gap:6px">
            <li><a href={pdfPath} target="_blank" rel="noreferrer" style="color:var(--accent)">PDF</a></li>
            <li><a href={mdPath} target="_blank" rel="noreferrer" style="color:var(--accent)">Markdown</a></li>
            <li><a href={htmlPath} target="_blank" rel="noreferrer" style="color:var(--accent)">HTML</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="skill-list">
        {skillGroups.map((group) => (
          <div class="skill-list-group">
            <h3>{group.title}</h3>
            <div class="skill-items">
              {group.items.map((item) => <span class="tag">{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>