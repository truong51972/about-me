---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimelineItem from "../components/TimelineItem.astro";
import SkillBox from "../components/SkillBox.astro";
import { site, timeline, education, skillGroups, cases } from "../data/profile";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="CV" description="CV summary for Tran Quoc Truong." >
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">CV</div>
      <h1>{site.name}</h1>
      <p class="page-summary">{site.role} · {site.tagline}. {site.summary}</p>
      <div class="hero-actions">
        <a class="btn primary" href={`${base}Tran_Quoc_Truong_CV.yaml`} target="_blank" rel="noreferrer">Open CV YAML</a>
        <a class="btn" href={`mailto:${site.email}`}>Email</a>
        <a class="btn ghost" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container content-grid">
      <article class="article">
        <section class="block">
          <div class="eyebrow">Positioning</div>
          <h2>Applied AI Engineer focused on Agentic QA, RAG systems, and Python backend.</h2>
          <p>My profile combines AI workflow design with backend control-plane engineering and QA automation. The main story is not only model usage, but how AI outputs become traceable product workflows.</p>
        </section>

        <section class="block">
          <div class="eyebrow">Experience</div>
          <div class="timeline">
            {timeline.map((item) => <TimelineItem item={item} />)}
          </div>
        </section>

        <section class="block">
          <div class="eyebrow">Selected projects</div>
          <h2>Projects</h2>
          <ul class="clean">
            {cases.map((item) => <li><strong style="color:var(--text)">{item.title}</strong> — {item.summary}</li>)}
          </ul>
        </section>
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h3>Contact</h3>
          <p>{site.location}</p>
          <p style="margin-top:8px"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div class="side-card">
          <h3>Education</h3>
          {education.map((item) => (
            <div style="border-top:1px solid var(--line);padding-top:12px;margin-top:12px">
              <strong>{item.degree}</strong>
              <p>{item.org}</p>
              <p>{item.period}</p>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="skills-grid">
        {skillGroups.map((group) => <SkillBox group={group} />)}
      </div>
    </div>
  </section>
</BaseLayout>
