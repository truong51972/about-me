---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, timeline, education, skillGroups, cases } from "../data/profile";

const pdfPath = withBase("cv/Tran_Quoc_Truong_CV.pdf");
const htmlPath = withBase("cv/Tran_Quoc_Truong_CV.html");
const yamlPath = withBase("Tran_Quoc_Truong_CV.yaml");
const mdPath = withBase("cv/Tran_Quoc_Truong_CV.md");
const cvProjectSlugs = ["omni-agent", "ata", "apit"];
const cvProjects = cases.filter((item) => cvProjectSlugs.includes(item.slug));
---

<BaseLayout title="CV" description="CV summary for Tran Quoc Truong.">
  <section class="border-b border-white/10 pb-16 pt-28 md:pb-24 md:pt-36">
    <div class="site-shell">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <div class="eyebrow mb-6">Curriculum vitae</div>
          <h1 class="text-4xl font-semibold leading-tight text-white md:text-6xl">{site.name}</h1>
          <p class="measure mt-6 text-xl leading-9 text-text-muted">{site.role}. {site.summary}</p>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
          <a class="btn-primary" href={pdfPath} target="_blank" rel="noreferrer">Download PDF</a>
          <a class="btn-secondary" href={htmlPath} target="_blank" rel="noreferrer">Open HTML</a>
          <a class="btn-secondary" href={yamlPath} target="_blank" rel="noreferrer">YAML source</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="site-shell grid gap-10 lg:grid-cols-[20rem_minmax(0,1fr)] xl:grid-cols-[22rem_minmax(0,1fr)]">
      <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
        <div class="evidence-card">
          <h3>Contact</h3>
          <p>{site.location}</p>
          <p class="mt-3"><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p class="mt-3"><a href={site.github} target="_blank" rel="noreferrer">GitHub</a></p>
          <p class="mt-3"><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></p>
        </div>

        <div class="evidence-card">
          <h3>Downloads</h3>
          <div class="grid gap-2">
            <a class="btn-secondary justify-start px-4 py-2" href={pdfPath} target="_blank" rel="noreferrer">PDF</a>
            <a class="btn-secondary justify-start px-4 py-2" href={mdPath} target="_blank" rel="noreferrer">Markdown</a>
            <a class="btn-secondary justify-start px-4 py-2" href={htmlPath} target="_blank" rel="noreferrer">HTML</a>
          </div>
        </div>

        <div class="evidence-card">
          <h3>Education</h3>
          <div class="space-y-5">
            {education.map((item) => (
              <div>
                <strong class="block leading-tight text-white">{item.degree}</strong>
                <p class="mt-2 text-sm leading-6 text-text-muted">{item.org}</p>
                <p class="mt-1 font-mono text-xs text-brand-300">{item.period}</p>
              </div>
            ))}
          </div>
        </div>
      </aside>

      <article class="space-y-16">
        <section class="surface-panel rounded-2xl p-6 md:p-8">
          <h2 class="section-label mb-4">Positioning</h2>
          <h3 class="max-w-4xl text-3xl font-semibold leading-tight text-white">
            Product Engineer focused on backend systems and applied AI workflows.
          </h3>
          <p class="measure mt-5 text-lg leading-8 text-text-muted">
            {site.about}
          </p>
        </section>

        <section>
          <h2 class="section-label mb-6">Experience</h2>
          <div class="space-y-5">
            {timeline.map((item) => (
              <article class="bento-card">
                <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_12rem]">
                  <div>
                    <h3>{item.title}</h3>
                    <p class="mt-2 text-sm font-medium text-brand-300">{item.org}</p>
                  </div>
                  <p class="font-mono text-sm text-text-muted md:text-right">{item.period}</p>
                </div>
                <ul class="mt-6 grid gap-3 text-sm leading-7 text-text-muted md:grid-cols-3">
                  {item.bullets.map((bullet) => (
                    <li class="border-t border-white/10 pt-3">{bullet}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section>
          <h2 class="section-label mb-6">Selected projects</h2>
          <div class="grid gap-5 md:grid-cols-3">
            {cvProjects.map((item) => (
              <a class="group block" href={withBase(`projects/${item.slug}/`)}>
                <article class="bento-card h-full">
                  <p class="font-mono text-xs text-brand-300">{item.period}</p>
                  <h3 class="mt-3 group-hover:text-brand-300">{item.title}</h3>
                  <p class="mt-4 text-sm leading-7 text-text-muted">{item.summary}</p>
                </article>
              </a>
            ))}
          </div>
        </section>
      </article>
    </div>
  </section>

  <section class="border-t border-white/10 bg-bg-surface/25 py-16 md:py-24">
    <div class="site-shell">
      <div class="mb-10 grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h2 class="section-label mb-4">Technical skills</h2>
          <p class="text-3xl font-semibold leading-tight text-white md:text-4xl">
            Practical stack coverage across model workflows, service boundaries, and quality gates.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
        {skillGroups.map((group) => (
          <article class="bento-card">
            <h3 class="min-h-12 text-base">{group.title}</h3>
            <div class="mt-5 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
