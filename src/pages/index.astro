---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, cases, education, skillGroups, supportingTools, timeline } from "../data/profile";

const pdfPath = withBase("cv/Tran_Quoc_Truong_CV.pdf");
const featured = cases.filter((item) => item.homepageFeatured);
const projectHref = (slug: string) => withBase(`projects/${slug}/`);
---

<BaseLayout>
  <section class="hero" id="top">
    <div class="container hero-inner">
      <figure class="hero-portrait">
        <img
          src={withBase("images/portrait-photo.png")}
          alt="Portrait of Tran Quoc Truong"
          width="941"
          height="1672"
          loading="eager"
        />
      </figure>

      <div class="hero-copy">
        <h1 class="hero-name">{site.name}</h1>
        <p class="hero-role">{site.role}</p>
        <p class="hero-summary">{site.summary}</p>
        <div class="hero-actions">
          <a class="btn primary" href={pdfPath} target="_blank" rel="noreferrer">Download CV</a>
          <a class="btn ghost" href={withBase("projects/")}>View projects</a>
          <a class="btn ghost" href={`mailto:${site.email}`}>Email</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <div class="section-kicker">FEATURED PROJECTS</div>
      <div class="section-heading-row">
        <h3 class="section-title">Applied AI, backend systems, and quality engineering.</h3>
        <a class="section-text-link" href={withBase("projects/")}>View all projects -&gt;</a>
      </div>
      <div class="featured-projects">
        {featured.map((item) => (
          <a class="project-row" href={projectHref(item.slug)}>
            <div class="project-row-head">
              <div class="project-card-meta">
                <div class="project-card-label">{item.label}</div>
                {item.period && <div class="project-period">{item.period}</div>}
              </div>
              <h3 class="project-card-title">{item.title}</h3>
              <p class="project-card-sub">{item.subtitle}</p>
            </div>
            <div class="project-row-body">
              <p class="project-row-desc">{item.summary}</p>
              <div class="project-card-stack">
                {item.tags.slice(0, 6).map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <span class="project-row-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <h2 class="section-title">Experience</h2>
      <div class="experience-list">
        {timeline.map((item) => (
          <div class="experience-item">
            <div class="experience-head">
              <h3>{item.org.split(" · ")[0]} - {item.title}</h3>
              <span class="experience-period">{item.period}</span>
            </div>
            <ul class="experience-bullets">
              {item.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="education">
    <div class="container">
      <h2 class="section-title">Education</h2>
      <div class="education-list">
        {education.map((item) => (
          <article class="education-item">
            <div class="education-head">
              <div>
                <h3>{item.degree}</h3>
                <p class="education-org">{item.org}</p>
              </div>
              <span class="education-period">{item.period}</span>
            </div>
            <p class="education-note">{item.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="container">
      <h2 class="section-title">Skills</h2>
      <div class="skill-list">
        {skillGroups.map((group) => (
          <div class="skill-list-group">
            <h3 class="skill-group-title">{group.title}</h3>
            <p class="skill-line">{group.items.join(", ")}</p>
          </div>
        ))}
      </div>
      <p class="supporting-tools">Supporting tools: {supportingTools.join(", ")}.</p>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container content-compact cta-content">
      <h2>Interested in Applied AI backend or evaluation work?</h2>
      <div class="cta-links">
        <a href={`mailto:${site.email}`} class="cta-link">Email me</a>
        <a href={site.github} target="_blank" rel="noreferrer" class="cta-link">GitHub</a>
        <a href={site.linkedin} target="_blank" rel="noreferrer" class="cta-link">LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>
