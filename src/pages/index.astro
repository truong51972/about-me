---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, cases, education, skillGroups, supportingTools, timeline } from "../data/profile";

const pdfPath = withBase("cv/Tran_Quoc_Truong_CV.pdf");
const featured = cases.filter((item) => item.homepageFeatured);
const projectHref = (slug: string) => withBase(`projects/${slug}/`);
const projectImages: Record<string, string> = {
  "omni-agent": "images/project-omni-panel.png",
  ata: "images/project-ata-panel.png",
  apit: "images/project-apit-panel.png"
};
---

<BaseLayout>
  <section class="relative overflow-hidden pb-20 pt-28 md:pb-28 md:pt-36" id="top">
    <div class="site-shell relative z-10">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5 lg:order-1">
          <div class="media-panel relative aspect-[4/5] max-h-[640px] bg-bg-surface">
            <img
              src={withBase("images/portrait-photo.png")}
              alt="Portrait of Tran Quoc Truong"
              class="object-cover object-[50%_52%]"
              loading="eager"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-bg-base/88 to-transparent p-5">
              <p class="text-sm font-medium text-white">{site.location}</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 lg:order-2">
          <div class="eyebrow mb-7">Available for new opportunities</div>
          <h1 class="max-w-5xl text-5xl font-semibold leading-[0.98] tracking-tight text-white sm:text-6xl lg:text-7xl">
            {site.name}
          </h1>
          <p class="mt-7 max-w-4xl text-2xl font-medium leading-tight text-brand-300 md:text-3xl">
            {site.role}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="tag px-3 py-1.5 text-sm font-semibold text-white hover:border-brand-400/35 hover:bg-white/[0.08]" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
            <a class="tag px-3 py-1.5 text-sm font-semibold text-white hover:border-brand-400/35 hover:bg-white/[0.08]" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
            <a class="tag px-3 py-1.5 text-sm font-semibold text-white hover:border-brand-400/35 hover:bg-white/[0.08]" href={`mailto:${site.email}`}>Email</a>
          </div>
          <p class="measure mt-7 text-lg leading-8 text-text-muted md:text-xl md:leading-9">
            {site.summary}
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={pdfPath} target="_blank" rel="noreferrer" class="btn-primary">Download CV</a>
            <a href={withBase("projects/")} class="btn-secondary">View projects</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-bg-surface/35 py-20 md:py-24" id="projects">
    <div class="site-shell">
      <div class="mb-10 grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-5">
          <h2 class="section-label mb-4">Featured projects</h2>
          <p class="max-w-3xl text-3xl font-semibold leading-tight text-white md:text-5xl">
            Systems that prove the direction.
          </p>
        </div>
        <div class="lg:col-span-7 lg:text-right">
          <a class="font-semibold text-brand-300 hover:text-white" href={withBase("projects/")}>View all projects</a>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
        {featured.map((item) => (
          <a
            href={projectHref(item.slug)}
            class={`group block ${item.visualTier === "flagship" ? "lg:col-span-7 lg:row-span-2" : "lg:col-span-5"}`}
          >
            <article class="project-card">
              <div class="project-art mb-6">
                <img src={withBase(projectImages[item.slug])} alt={`${item.title} abstract technical panel`} loading="lazy" />
              </div>
              <div class="mb-5 flex flex-wrap items-center gap-2">
                <span class="tag border-brand-400/20 bg-brand-400/10 text-brand-300">{item.label}</span>
                {item.period && <span class="tag">{item.period}</span>}
              </div>
              <h3>{item.title}</h3>
              <p class="mt-3 text-sm font-medium text-brand-300/85">{item.subtitle}</p>
              <p class={`mt-5 ${item.visualTier === "flagship" ? "text-base" : "text-sm"}`}>{item.summary}</p>
              <div class="mt-7 flex flex-wrap gap-2">
                {item.tags.slice(0, item.visualTier === "flagship" ? 8 : 5).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28" id="experience">
    <div class="site-shell grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="section-label mb-4">Experience</h2>
        <p class="measure-tight text-3xl font-semibold leading-tight text-white md:text-4xl">
          QA discipline, applied to AI systems.
        </p>
        <p class="mt-5 text-base leading-7 text-text-muted">
          Banking validation experience now informs agent evaluation, backend orchestration, and evidence-first workflows.
        </p>
      </div>
      <div class="lg:col-span-8">
        <div class="space-y-5">
          {timeline.map((item) => (
            <article class="bento-card">
              <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_12rem]">
                <div>
                  <p class="text-sm font-medium text-brand-300">{item.org}</p>
                  <h3 class="mt-2">{item.title}</h3>
                </div>
                <div class="font-mono text-sm text-text-muted md:text-right">{item.period}</div>
              </div>
              <ul class="mt-6 grid gap-3 text-sm leading-7 text-text-muted md:grid-cols-3">
                {item.bullets.map((bullet) => (
                  <li class="border-t border-white/10 pt-3">{bullet}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-bg-surface/25 py-20 md:py-28">
    <div class="site-shell grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="section-label mb-4">Education</h2>
        <p class="measure-tight text-3xl font-semibold leading-tight text-white md:text-4xl">
          Formal AI and software engineering training.
        </p>
        <p class="mt-5 text-base leading-7 text-text-muted">
          Academic foundation for applied AI, computer vision, model evaluation, and production-oriented software systems.
        </p>
      </div>
      <div class="lg:col-span-8">
        <div class="space-y-5">
          {education.map((item) => (
            <article class="bento-card">
              <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_12rem]">
                <div>
                  <p class="text-sm font-medium text-brand-300">{item.org}</p>
                  <h3 class="mt-2">{item.degree}</h3>
                </div>
                <div class="font-mono text-sm text-text-muted md:text-right">{item.period}</div>
              </div>
              <p class="mt-6 border-t border-white/10 pt-4 text-sm leading-7 text-text-muted">{item.note}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28" id="education-skills">
    <div class="site-shell grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="section-label mb-4">Technical skills</h2>
        <p class="measure-tight text-3xl font-semibold leading-tight text-white md:text-4xl">
          Stack for AI backend work.
        </p>
        <p class="mt-5 text-base leading-7 text-text-muted">
          Python services, retrieval systems, agent evaluation, and quality workflows for applied AI products.
        </p>
        <p class="mt-6 border-t border-white/10 pt-5 text-sm leading-7 text-text-muted">
          <span class="font-semibold text-white">Supporting tools:</span> {supportingTools.join(", ")}.
        </p>
      </div>
      <div class="lg:col-span-8">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {skillGroups.map((group) => (
            <article class="bento-card">
              <h3>{group.title}</h3>
              <div class="mt-5 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="site-shell">
      <div class="surface-panel grid gap-8 rounded-2xl p-7 md:p-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div>
          <h2 class="text-3xl font-semibold leading-tight text-white md:text-5xl">Build, evaluate, and ship AI workflows with evidence.</h2>
          <p class="measure mt-5 text-lg leading-8 text-text-muted">
            Available for applied AI backend, RAG, agent evaluation, and Python service work.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a href={`mailto:${site.email}`} class="btn-primary">Get in touch</a>
          <a href={site.github} target="_blank" rel="noreferrer" class="btn-secondary">GitHub</a>
          <a href={site.linkedin} target="_blank" rel="noreferrer" class="btn-secondary">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
