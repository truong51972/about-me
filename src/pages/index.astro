---
import { withBase } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import HonorsSection from "../components/HonorsSection.astro";
import { site, cases, education, skillGroups, timeline } from "../data/profile";

const pdfPath = withBase("cv/Tran_Quoc_Truong_CV.pdf");
const projectHref = (slug: string) => withBase(`projects/${slug}/`);

const projectImages: Record<string, string> = {
  "omni-agent": "images/project-omni-panel.png",
  ata: "images/project-ata-panel.png",
  iqp: "images/project-iqp-panel.jpg",
  apit: "images/project-apit-panel.png",
  "banking-automation": "images/project-iqp-panel.jpg",
  lms: "images/project-lms-panel.jpg",
  "self-driving-car": "images/project-vision-panel.png"
};

// Four complementary flagship cases: platform, model engineering, enterprise delivery and assurance
const flagshipSlugs = ["omni-agent", "apit", "iqp", "ata"];
const featuredCases = flagshipSlugs
  .map((slug) => cases.find((c) => c.slug === slug))
  .filter((c): c is (typeof cases)[0] => Boolean(c));

// Supporting projects for archive teaser
const supportingCases = cases.filter((c) => !flagshipSlugs.includes(c.slug));
---

<BaseLayout>
  {/* 1. Hero Section: Positioning & Mini System Architecture Flow */}
  <section class="pb-16 pt-24 md:pb-24 md:pt-32" id="top">
    <div class="site-shell">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        {/* Left Column: Identity, Positioning & Quick Actions */}
        <div class="lg:col-span-7">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-400/15 dark:text-emerald-300">
            <span class="h-2 w-2 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse"></span>
            Available for new opportunities
          </div>

          <h1 class="text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-6xl">
            {site.name}
          </h1>

          <p class="mt-3 text-xl font-bold text-sky-700 dark:text-sky-400 sm:text-2xl">
            {site.role}
          </p>

          <p class="mt-2 text-base font-semibold text-[var(--text-primary)] sm:text-lg">
            {site.tagline}
          </p>

          <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
            {site.summary}
          </p>

          {/* Action Buttons */}
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#featured-work" class="btn-primary">
              View Featured Work
            </a>
            <a href={pdfPath} target="_blank" rel="noreferrer" class="btn-secondary">
              Download CV (PDF)
            </a>
          </div>

          {/* Metadata & Profiles */}
          <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-secondary)]">{site.location}</span>
            <span class="text-slate-300 dark:text-slate-700">·</span>
            <a
              class="font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-300"
              href={site.github}
              target="_blank"
              rel="noreferrer"
            >
              GitHub ↗
            </a>
            <span class="text-slate-300 dark:text-slate-700">·</span>
            <a
              class="font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-300"
              href={site.linkedin}
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn ↗
            </a>
            <span class="text-slate-300 dark:text-slate-700">·</span>
            <a
              class="font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-300"
              href={`mailto:${site.email}`}
            >
              {site.email}
            </a>
          </div>
        </div>

        {/* Right Column: Portrait Photo */}
        <div class="lg:col-span-5">
          <div class="mx-auto max-w-sm lg:max-w-none">
            <div class="overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--card-bg)] shadow-md transition hover:border-sky-500/30">
              <div class="aspect-[4/5] w-full overflow-hidden bg-slate-100 dark:bg-slate-900">
                <img
                  src={withBase("images/portrait-photo.png")}
                  alt={`Portrait of ${site.name}`}
                  class="h-full w-full object-cover object-[50%_35%]"
                  loading="eager"
                />
              </div>
              <div class="border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] p-3.5 text-center">
                <p class="text-sm font-bold text-[var(--text-primary)]">{site.name}</p>
                <p class="text-xs text-[var(--text-muted)]">{site.role}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 2. Featured Work: four complementary project case studies */}
  <section class="border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-20 md:py-24" id="featured-work">
    <div class="site-shell">
      <div class="mb-12 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <span class="inline-flex items-center rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
            Engineering Evidence
          </span>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--text-primary)] md:text-4xl">
            Featured Work
          </h2>
          <p class="mt-2 max-w-2xl text-base text-[var(--text-secondary)]">
            Systems designed around concrete operational needs, showing the path from problem framing and architecture to delivery, evaluation, and measurable outcomes.
          </p>
        </div>
        <div>
          <a
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200"
            href={withBase("projects/")}
          >
            <span>View all {cases.length} case studies</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {featuredCases.map((item) => (
          <a href={projectHref(item.slug)} class="group block h-full">
            <article class="bento-card flex h-full flex-col justify-between transition group-hover:border-sky-500/40">
              <div>
                {projectImages[item.slug] && (
                  <div class="mb-5 aspect-[16/10] w-full overflow-hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]">
                    <img
                      src={withBase(projectImages[item.slug])}
                      alt={`${item.title} preview`}
                      loading="lazy"
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                    />
                  </div>
                )}

                <div class="mb-3 flex items-center justify-between gap-2">
                  <span class="rounded-md border border-sky-500/20 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
                    {item.label}
                  </span>
                  {item.period && (
                    <span class="font-mono text-xs text-[var(--text-muted)]">{item.period}</span>
                  )}
                </div>

                <h3 class="text-xl font-bold text-[var(--text-primary)] group-hover:text-sky-700 dark:group-hover:text-sky-400">
                  {item.title}
                </h3>

                <p class="mt-1 text-xs font-semibold text-sky-700 dark:text-sky-400">
                  {item.subtitle}
                </p>

                <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
                  {item.summary}
                </p>

                {/* Key Technical Capabilities */}
                <div class="mt-5 space-y-2 border-t border-[var(--border-subtle)] pt-4 text-xs text-[var(--text-secondary)]">
                  {item.highlights.slice(0, 3).map((highlight) => (
                    <div class="flex items-start gap-2">
                      <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
                      <span class="leading-relaxed">{highlight}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="mt-6 border-t border-[var(--border-subtle)] pt-4">
                <div class="mb-4 flex flex-wrap gap-1.5">
                  {item.tags.slice(0, 6).map((tag) => (
                    <span class="tag font-mono text-[11px]">{tag}</span>
                  ))}
                </div>
                <div class="inline-flex items-center gap-1 text-xs font-semibold text-sky-700 dark:text-sky-400 group-hover:translate-x-0.5 transition-transform">
                  <span>View Case Study</span>
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 3. Engineering Profile: What I Build (3 Columns) */}
  <section class="border-t border-[var(--border-subtle)] py-20 md:py-24" id="what-i-build">
    <div class="site-shell">
      <div class="mb-12 max-w-3xl">
        <span class="inline-flex items-center rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
          Core Focus
        </span>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--text-primary)] md:text-4xl">
          How I Design Solutions
        </h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--text-secondary)]">
          I start from operational constraints and desired outcomes, design the system boundaries and AI approach, then carry the solution through implementation, integration, and reliability verification.
        </p>
      </div>

      {/* End-to-End System Architecture Pipeline */}
      <div class="mb-10 rounded-xl border border-[var(--border-subtle)] bg-[var(--card-bg)] p-5 shadow-sm">
        <div class="mb-3 flex items-center justify-between">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-sky-700 dark:text-sky-400">
            End-to-End Solution Delivery
          </span>
          <span class="font-mono text-[11px] text-[var(--text-muted)]">Problem → Architecture → Delivery → Assurance</span>
        </div>
        <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-4 font-mono text-xs">
          <div class="flex items-center gap-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)] p-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-sky-500"></span>
            <div>
              <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider">Stage 1</div>
              <div class="font-semibold text-[var(--text-primary)]">Problem & Constraints</div>
            </div>
          </div>
          <div class="flex items-center gap-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)] p-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-sky-500"></span>
            <div>
              <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider">Stage 2</div>
              <div class="font-semibold text-[var(--text-primary)]">Solution Architecture</div>
            </div>
          </div>
          <div class="flex items-center gap-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)] p-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-sky-500"></span>
            <div>
              <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider">Stage 3</div>
              <div class="font-semibold text-[var(--text-primary)]">Delivery & Integration</div>
            </div>
          </div>
          <div class="flex items-center gap-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)] p-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-sky-500"></span>
            <div>
              <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider">Stage 4</div>
              <div class="font-semibold text-[var(--text-primary)]">Evaluation & Reliability</div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {/* Column 1: AI Systems */}
        <article class="bento-card">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg border border-sky-500/20 bg-sky-500/10 text-sky-700 dark:text-sky-300">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 16.5V21m3.75-18v1.5m0 16.5V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[var(--text-primary)]">AI Systems</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            Autonomous multi-agent orchestration, contextual retrieval, and grounded reasoning built on real operational data.
          </p>
          <ul class="mt-5 space-y-2.5 text-xs text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-4">
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">LangGraph Runtimes:</strong> Structured agent routing, research specialists, and evidence curation</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Model Context Protocol (MCP):</strong> Streamable HTTP tool servers</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Knowledge Processing:</strong> Docling OCR, versioned evidence, and PostgreSQL–Qdrant hybrid search</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Model Customization:</strong> LoRA fine-tuning & prompt optimization</span>
            </li>
          </ul>
        </article>

        {/* Column 2: Backend Platforms */}
        <article class="bento-card">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg border border-sky-500/20 bg-sky-500/10 text-sky-700 dark:text-sky-300">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.75 5.1a3 3 0 012.4-1.35h7.7a3 3 0 012.4 1.35l2.1 3.15c.6.9.9 1.8.9 2.7" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[var(--text-primary)]">Backend Platforms</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            Scalable control planes, distributed asynchronous workflows, and clean domain boundaries.
          </p>
          <ul class="mt-5 space-y-2.5 text-xs text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-4">
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Python Backend:</strong> FastAPI, Django/DRF, and SSE streaming across different projects</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Async Orchestration:</strong> Decoupled Celery workers and Redis queues</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Data Layer:</strong> PostgreSQL schemas, SQLAlchemy ORM, and MinIO S3 storage</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Platform Orchestration:</strong> Docker Compose, Nginx reverse proxy, and Linux</span>
            </li>
          </ul>
        </article>

        {/* Column 3: Reliability & Evaluation */}
        <article class="bento-card">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg border border-sky-500/20 bg-sky-500/10 text-sky-700 dark:text-sky-300">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[var(--text-primary)]">Reliability & Evaluation</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            Software testing discipline applied to probabilistic AI systems, observability, and deterministic quality gates.
          </p>
          <ul class="mt-5 space-y-2.5 text-xs text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-4">
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Trace Reconstruction:</strong> OpenTelemetry & LiteLLM trajectory normalization</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Evidence-Based Evaluation:</strong> Record-level behavioral assessment and trace-linked judgments</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Quality Gates:</strong> Agent Goals, decisive failures, and explicit inconclusive outcomes</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
              <span><strong class="text-[var(--text-primary)]">Runtime Guardrails:</strong> Input/context/output checks and sensitive-data protections</span>
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  {/* 4. Experience Timeline: Impact-First Narrative */}
  <section class="border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-20 md:py-24" id="experience">
    <div class="site-shell grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-flex items-center rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
          Career Trajectory
        </span>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--text-primary)] md:text-4xl">
          Work Experience
        </h2>
        <p class="mt-3 text-base text-[var(--text-secondary)]">
          End-to-end solution delivery across applied AI, backend architecture, evaluation, and enterprise systems.
        </p>
      </div>

      <div class="lg:col-span-8">
        <div class="space-y-6">
          {timeline.map((item) => (
            <article class="bento-card">
              <div class="grid gap-2 md:grid-cols-[minmax(0,1fr)_12rem] md:items-baseline">
                <div>
                  <h3 class="text-lg font-bold text-[var(--text-primary)]">{item.title}</h3>
                  <p class="text-sm font-semibold text-sky-700 dark:text-sky-400">{item.org}</p>
                </div>
                <div class="font-mono text-xs text-[var(--text-muted)] md:text-right">{item.period}</div>
              </div>
              <ul class="mt-4 space-y-2.5 text-sm text-[var(--text-secondary)]">
                {item.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
                    <span class="leading-relaxed">{bullet}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* 5. Technical Skills: Capability-Based Organization */}
  <section class="border-t border-[var(--border-subtle)] py-20 md:py-24" id="skills">
    <div class="site-shell">
      <div class="mb-10 max-w-2xl">
        <span class="inline-flex items-center rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
          Engineering Capabilities
        </span>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--text-primary)] md:text-4xl">
          Technical Skills
        </h2>
        <p class="mt-2 text-base text-[var(--text-secondary)]">
          Technical capabilities used to turn solution designs into reliable, testable systems.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
        {skillGroups.map((group) => (
          <article class="bento-card flex flex-col justify-between">
            <div>
              <h3 class="text-base font-bold text-[var(--text-primary)]">{group.title}</h3>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <span class="tag font-mono text-xs">{item}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 6. Honors & Awards: External Validation */}
  <HonorsSection />

  {/* 7. Education Section */}
  <section class="border-t border-[var(--border-subtle)] py-20 md:py-24" id="education">
    <div class="site-shell grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-flex items-center rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
          Academic Foundations
        </span>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--text-primary)] md:text-4xl">
          Education
        </h2>
        <p class="mt-3 text-base text-[var(--text-secondary)]">
          Formal software engineering and artificial intelligence training.
        </p>
      </div>

      <div class="lg:col-span-8">
        <div class="space-y-5">
          {education.map((item) => (
            <article class="bento-card">
              <div class="grid gap-2 md:grid-cols-[minmax(0,1fr)_12rem] md:items-baseline">
                <div>
                  <h3 class="text-lg font-bold text-[var(--text-primary)]">{item.degree}</h3>
                  <p class="text-sm font-semibold text-sky-700 dark:text-sky-400">{item.org}</p>
                </div>
                <div class="font-mono text-xs text-[var(--text-muted)] md:text-right">{item.period}</div>
              </div>
              <p class="mt-3 border-t border-[var(--border-subtle)] pt-3 text-sm text-[var(--text-secondary)]">
                {item.note}
              </p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* 8. More Projects: Archive Teaser */}
  <section class="border-t border-[var(--border-subtle)] bg-[var(--bg-subtle)]/30 py-16 md:py-20" id="more-projects">
    <div class="site-shell">
      <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <span class="inline-flex items-center rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">
            Project Archive
          </span>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-[var(--text-primary)] md:text-3xl">
            More Engineering Projects
          </h2>
          <p class="mt-1 text-sm text-[var(--text-secondary)]">
            Earlier systems, capstones, and industry deliveries.
          </p>
        </div>
        <div>
          <a
            class="inline-flex items-center gap-1 text-sm font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200"
            href={withBase("projects/")}
          >
            <span>Browse complete catalog ({cases.length} case studies) →</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {supportingCases.map((item) => (
          <a href={projectHref(item.slug)} class="group block h-full">
            <article class="bento-card flex h-full flex-col justify-between p-5 transition group-hover:border-sky-500/40">
              <div>
                <div class="mb-2 flex items-center justify-between text-xs">
                  <span class="font-mono text-sky-700 dark:text-sky-400">{item.period}</span>
                </div>
                <h3 class="text-base font-bold text-[var(--text-primary)] group-hover:text-sky-700 dark:group-hover:text-sky-400 line-clamp-1">
                  {item.title}
                </h3>
                <p class="mt-2 text-xs leading-relaxed text-[var(--text-muted)] line-clamp-3">
                  {item.summary}
                </p>
              </div>
              <div class="mt-4 border-t border-[var(--border-subtle)] pt-3 text-xs font-semibold text-sky-700 dark:text-sky-400">
                <span>Read case study →</span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 9. Contact Callout */}
  <section class="border-t border-[var(--border-subtle)] py-16 md:py-24" id="contact">
    <div class="site-shell">
      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--card-bg)] p-8 shadow-sm md:p-12">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-8">
            <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-400/15 dark:text-emerald-300">
              <span class="h-2 w-2 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
              Open to Opportunities
            </div>
            <h2 class="text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl md:text-4xl">
              Let's turn a real problem into a reliable AI system.
            </h2>
            <p class="mt-3 max-w-2xl text-base text-[var(--text-secondary)]">
              Open to Applied AI, product engineering, and backend platform roles where solution design, hands-on delivery, and measurable reliability matter.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row lg:col-span-4 lg:flex-col lg:items-end">
            <a href={`mailto:${site.email}`} class="btn-primary w-full text-center sm:w-auto">
              Send Email
            </a>
            <a href={site.linkedin} target="_blank" rel="noreferrer" class="btn-secondary w-full text-center sm:w-auto">
              Connect on LinkedIn ↗
            </a>
            <a href={pdfPath} target="_blank" rel="noreferrer" class="btn-secondary w-full text-center sm:w-auto">
              Download Full CV (PDF)
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
