---
import { withBase } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cases } from "../../data/profile";
const item = cases.find((caseItem) => caseItem.slug === "omni-agent")!;
---
<BaseLayout title="Omni-Agent" description="Omni-Agent case study by Tran Quoc Truong." >
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="case-index">{item.label}</div>
      <h1>Omni-Agent: enterprise AI platform for Agentic QA and document intelligence.</h1>
      <p class="page-summary">{item.summary}</p>
      <div class="hero-actions">
        <a class="btn primary" href="https://github.com/truong51972" target="_blank" rel="noreferrer">View GitHub</a>
        <a class="btn ghost" href={withBase("projects/")}>Back to projects</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container content-grid">
      <article class="article">
        <section class="block">
          <div class="eyebrow">Problem</div>
          <h2>Governing the workflow around RAG, not just calling an LLM.</h2>
          <p>Omni-Agent is designed as an enterprise console where Knowledge Builder and Agentic QA workflows live under project-level boundaries. The hard part is making documents, versions, artifacts, jobs, chunks, vector records, and evaluation traces behave like a reliable product surface.</p>
          <p>Django owns domain state, worker services perform technical jobs, and result envelopes return evidence that can be stored, reviewed, retried, or indexed.</p>
        </section>

        <section class="block">
          <div class="eyebrow">Architecture</div>
          <h2>Control plane, workers, artifacts, and retrieval are separated.</h2>
          <div class="diagram">
            <div class="diagram-step"><b>Project console</b><span>React UI for documents, versions, preview, jobs, and review actions.</span></div>
            <div class="diagram-step"><b>Django API</b><span>Domain models, permissions, jobs, source-of-truth state, and presigned artifact access.</span></div>
            <div class="diagram-step"><b>Stateless workers</b><span>OCR, chunking, document conversion, and indexing commands via queue/result envelopes.</span></div>
            <div class="diagram-step"><b>RAG layer</b><span>Chunks, vector DB sync, retrieval traces, and Agentic QA workflows.</span></div>
          </div>
        </section>

        <section class="block">
          <div class="eyebrow">Key highlights</div>
          <ul class="clean" style="margin-top:0">
            {item.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </section>

        <section class="block">
          <div class="eyebrow">Stack</div>
          <div class="tag-row" style="padding-top:0;margin-top:10px">
            {item.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </section>
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h3>Role</h3>
          <p>{item.role}</p>
        </div>
        <div class="side-card">
          <h3>Evidence</h3>
          <p>{item.outcome}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>