---
import { withBase } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cases } from "../../data/profile";
const item = cases.find((caseItem) => caseItem.slug === "omni-agent")!;
---
<BaseLayout title="Omni-Agent" description="Omni-Agent case study by Tran Quoc Truong." >
  <section class="border-b border-[var(--border-subtle)] pb-14 pt-28 md:pb-20 md:pt-36">
    <div class="site-shell grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 mb-6">
          <span class="rounded-md border border-sky-500/20 bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-700 dark:border-sky-400/30 dark:bg-sky-400/15 dark:text-sky-300">{item.label}</span>
          {item.period && <span class="tag">{item.period}</span>}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-[var(--text-base)] mb-6 leading-tight max-w-4xl">{item.title}: {item.subtitle}</h1>
        <p class="text-lg text-[var(--text-muted)] max-w-3xl leading-relaxed mb-8">{item.summary}</p>
        <div class="flex flex-wrap gap-4">
          <a class="btn-primary" href="https://github.com/truong51972" target="_blank" rel="noreferrer">View GitHub</a>
          <a class="btn-secondary" href={withBase("projects/")}>Back to projects</a>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="surface-panel overflow-hidden rounded-2xl">
          <div class="project-art rounded-none border-0">
            <img src={withBase("images/project-omni-panel.png")} alt="Abstract document intelligence and knowledge graph panel for Omni-Agent" loading="eager" />
          </div>
          <div class="grid gap-0 divide-y divide-[var(--border-subtle)]">
            <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-4 p-5">
              <span class="font-mono text-xs uppercase tracking-[0.18em] text-sky-700 dark:text-sky-400">Role</span>
              <span class="text-sm leading-6 text-[var(--text-secondary)]">{item.role}</span>
            </div>
            <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-4 p-5">
              <span class="font-mono text-xs uppercase tracking-[0.18em] text-sky-700 dark:text-sky-400">Shape</span>
              <span class="text-sm leading-6 text-[var(--text-secondary)]">Multi-service Python monorepo with independently deployable domain applications and shared typed contracts</span>
            </div>
            <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-4 p-5">
              <span class="font-mono text-xs uppercase tracking-[0.18em] text-sky-700 dark:text-sky-400">Core</span>
              <span class="text-sm leading-6 text-[var(--text-secondary)]">Knowledge Builder (LangGraph multi-agent chat, Streamable HTTP MCP, Docling RAG), Agent Assurance (OTel telemetry, trace reconstruction, evaluation gates), and platform control plane</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="case-study-shell">
      <article class="case-article">
        <!-- Overview -->
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Overview</h2>
          <h3 class="text-2xl font-bold text-[var(--text-base)] mb-6">An Applied AI platform engineered from real operational needs.</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">Omni-Agent is an independently developed pre-production Applied AI platform addressing document knowledge access, verifiable agent workflows, and evidence-driven assurance. Architected as a Python monorepo with clean control-plane / data-plane separation, everything is scoped to an authenticated, isolated <strong class="text-[var(--text-base)]">Project</strong> workspace. The platform pairs agentic document intelligence with behavioral verification across two flagship capabilities:</p>
          <ul class="space-y-4 text-[var(--text-muted)] mb-6">
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Knowledge Builder</strong> — document intelligence featuring Docling layout parsing and OCR, versioned document retrieval, a Streamable HTTP Model Context Protocol (MCP) server, and a LangGraph-based multi-agent runtime with citation-grounded RAG.</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Agent Assurance (3rd Place, IVS Hackathon 2026)</strong> — a behavioral verification and observability engine capturing GenAI execution evidence through LiteLLM and OpenTelemetry-based telemetry, designing trace reconstruction pipelines, and enforcing deterministic evaluation quality gates.</li>
          </ul>
        </section>

        <!-- Architecture -->
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Architecture</h2>
          <h3 class="text-2xl font-bold text-[var(--text-base)] mb-6">Domain-owned AI services, not one shared application database.</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">The FastAPI Platform Control Plane owns project identity, membership, credentials, and gateway authorization. Knowledge Builder and Agent Assurance own their application state, migrations, execution workers, and interfaces independently. Project identifiers cross service boundaries as trusted context, not shared domain models.</p>
          <pre class="bg-[var(--bg-subtle)] p-6 rounded-xl border border-[var(--border-subtle)] text-sm font-mono text-sky-800 dark:text-sky-300 overflow-x-auto mb-6">Omni-Agent (project-scoped monorepo)
├── apps/
│   ├── oa-platform/
│   │   ├── control-plane/         FastAPI identity, projects, auth and permissions
│   │   └── front-end/            React console and contextual product workflows
│   ├── oa-knowledge-builder/
│   │   ├── api/                  Documents, versions, extraction and project APIs
│   │   ├── doc-processor/        Document transformation and chunking workers
│   │   ├── docling-server/       Document parsing and OCR runtime
│   │   ├── tool-server/          Project-scoped hybrid retrieval and MCP tools
│   │   └── knowledge-chat/       LangGraph agents, evidence and guarded answers
│   └── oa-agent-assurance/
│       ├── core/                 FastAPI, Scenarios, Runs, Trials and workers
│       └── llm-gateway/          LiteLLM and OpenTelemetry capture integration
└── shared infrastructure        PostgreSQL, Redis, S3/MinIO, Qdrant, Nginx</pre>
          <h3 class="text-lg font-bold text-[var(--text-base)] mb-4">Architectural decisions</h3>
          <ul class="space-y-4 text-[var(--text-muted)] mb-6">
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Domain ownership</strong> — isolate project administration, canonical knowledge data, and assurance evidence under the services that own their invariants.</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Durable processing</strong> — use transactional outbox commands, stable job identities, and retry/reconciliation to recover asynchronous operations without corrupting canonical results.</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:w-1.5 before:bg-sky-500"><strong class="text-[var(--text-base)]">Trust boundaries</strong> — authorize project-scoped reads before exposing retrieval evidence; keep credentials out of captured execution artifacts.</li>
          </ul>
        </section>

        <!-- Knowledge Builder -->
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Capability 1: Knowledge Builder</h2>
          <h3 class="text-2xl font-bold text-[var(--text-base)] mb-6">Usable knowledge survives downstream indexing failures.</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">Enterprise documents are ingested through versioned workflows. Docling provides PDF layout extraction/OCR, while dedicated workers perform deterministic, tokenizer-aware chunking. Canonical READY content is persisted separately from derived map, summary and vector indexes, so a failed indexing attempt does not erase the last usable document version.</p>
          <h4 class="text-lg font-bold text-[var(--text-base)] mb-3">Hybrid retrieval with evidence identity</h4>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">Indexed PostgreSQL lexical search is fused with dense Qdrant candidates through reciprocal rank fusion (RRF). The project-scoped MCP tool server hydrates candidates against canonical document/version state before exposing retrieval results; stale or unauthorized vector points cannot become answer evidence.</p>
          <h4 class="text-lg font-bold text-[var(--text-base)] mb-3">Agent orchestration and verifiable answers</h4>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">A LangGraph workflow routes questions to general, clarification, or research paths. Research uses dedicated corpus navigation, section selection, expansion, and evidence curation tools. The answer cites bounded, run-specific evidence; completed answers freeze their source snapshots so historical verification does not silently change when the source corpus evolves.</p>
          <h4 class="text-lg font-bold text-[var(--text-base)] mb-3">Guardrails across trust boundaries</h4>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">Input, untrusted context, and output checks complement a configurable self-hosted LiteLLM provider hook. Model-generated answer text is checked before public SSE publication; guardrails are defense-in-depth protections, not a guarantee against all prompt injection or leakage variants.</p>
        </section>

        <!-- Agent Assurance -->
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Capability 2: Agent Assurance</h2>
          <h3 class="text-2xl font-bold text-[var(--text-base)] mb-6">Reproducible agent testing from executable contracts to evidence-based gates.</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">The standalone Agent Assurance engine received <strong class="text-[var(--text-base)]">2nd Runner-up (3rd Place) at IVS Hackathon 2026</strong> before being integrated into Omni-Agent. It connects versioned requirements and executable Scenario contracts to qualified Runs, Trials, captured evidence and explicit evaluation outcomes.</p>
          {/* Real Hackathon Proof Imagery */}
          <div class="my-8 grid gap-4 sm:grid-cols-2">
            <figure class="overflow-hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]">
              <div class="aspect-[4/3] w-full overflow-hidden">
                <img
                  src={withBase("images/ivs-hackthon-2nd.jpg")}
                  alt="Team Nova4Test awarded 2nd Runner-up at IVS Hackathon 2026"
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              <figcaption class="p-3 text-xs leading-snug text-[var(--text-muted)]">
                Award Ceremony: Team Nova4Test (IVS HCM) receives 2nd Runner-up at IVS Hackathon 2026
              </figcaption>
            </figure>
            <figure class="overflow-hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]">
              <div class="aspect-[4/3] w-full overflow-hidden">
                <img
                  src={withBase("images/presenting.jpg")}
                  alt="Tran Quoc Truong pitching Agent Assurance on stage"
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              <figcaption class="p-3 text-xs leading-snug text-[var(--text-muted)]">
                Technical Defense: Truong presenting the agent evaluation and verification architecture
              </figcaption>
            </figure>
          </div>


          <div class="space-y-6 mb-8">
            <div class="surface-panel p-6 rounded-xl border border-[var(--border-subtle)]">
              <h4 class="text-lg font-bold text-[var(--text-base)] mb-2">1. Versioned assurance and qualified execution</h4>
              <p class="text-[var(--text-muted)] text-sm leading-relaxed">Each published Scenario freezes its SUT/OpenAPI targets, request/verification Flow, evaluation policy and published assurance references. Worker-executed preflight qualifies a Run and freezes the exact Scenario versions and capture policy; Trials execute that immutable basis.</p>
            </div>
            <div class="surface-panel p-6 rounded-xl border border-[var(--border-subtle)]">
              <h4 class="text-lg font-bold text-[var(--text-base)] mb-2">2. Runtime evidence and agent-aware reconstruction</h4>
              <p class="text-[var(--text-muted)] text-sm leading-relaxed">HTTP response capture and optional LiteLLM/OpenTelemetry OTLP ingestion provide correlated execution evidence. Idempotent records and AgentRun-aware timelines support investigation across an agent's behavior, not merely its final answer.</p>
            </div>
            <div class="surface-panel p-6 rounded-xl border border-[var(--border-subtle)]">
              <h4 class="text-lg font-bold text-[var(--text-base)] mb-2">3. Quality gates with explicit uncertainty</h4>
              <p class="text-[var(--text-muted)] text-sm leading-relaxed">Deterministic outcome assertions and configured semantic gates evaluate available evidence with distinct pass, fail and inconclusive paths. Missing evidence is never silently interpreted as a passing check. Immutable Candidate identity can be attached to Runs; complete release-decision governance remains future work.</p>
            </div>
          </div>
        </section>

        <!-- First Run First -->
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Product engineering: First Run First</h2>
          <h3 class="text-2xl font-bold text-[var(--text-base)] mb-6">Reducing Steps to First Value without weakening validation.</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">The original first-test journey exposed technical authoring resources before users could inspect a result. A guided Connect → Define Test → Run &amp; Result workspace now composes the existing Scenario publication, smoke preflight, Run/Trial execution, and evidence view. Advanced goals, profiles and Suites remain available contextually, but are not prerequisites for an exploratory first test.</p>
          <div class="grid gap-4 sm:grid-cols-3 mb-6">
            <div class="surface-panel rounded-xl p-5"><p class="text-sm text-[var(--text-muted)]">Full-authoring baseline</p><p class="text-3xl font-semibold text-[var(--text-base)] mt-2">33 actions</p></div>
            <div class="surface-panel rounded-xl p-5"><p class="text-sm text-[var(--text-muted)]">Own API quick test</p><p class="text-3xl font-semibold text-[var(--text-base)] mt-2">6 actions</p></div>
            <div class="surface-panel rounded-xl p-5"><p class="text-sm text-[var(--text-muted)]">Configured demo quick test</p><p class="text-3xl font-semibold text-[var(--text-base)] mt-2">4 actions</p></div>
          </div>
          <p class="text-[var(--text-muted)] leading-relaxed mb-4">The action counts come from a controlled, credential-free Playwright fixture starting at an already selected Project and using a fixed OpenAPI POST operation. Automatic backend work does not count as user actions; required SUT-call consent and preflight checks are preserved. Repeat execution requires one intentional action and a fresh preflight.</p>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">These are deterministic usability-regression measurements, <strong class="text-[var(--text-base)]">not production conversion, elapsed-time, or adoption metrics</strong>. <a class="text-sky-700 underline dark:text-sky-400" href="https://github.com/truong51972/Omni-Agent/blob/main/.documents/testing-acceptance.md" target="_blank" rel="noreferrer">Measurement protocol</a>.</p>
        </section>

        <!-- Platform foundations -->
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Platform foundations</h2>
          <h3 class="text-2xl font-bold text-[var(--text-base)] mb-6">Consistency, recovery, and operational trust.</h3>
          <ul class="space-y-4 text-[var(--text-muted)] mb-6">
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:bg-sky-500"><strong class="text-[var(--text-base)]">Canonical vs. derived state</strong> — document content and version eligibility are authoritative in PostgreSQL; derived Qdrant indexes can be retried and reconciled without hiding READY content.</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:bg-sky-500"><strong class="text-[var(--text-base)]">Durable workers</strong> — transactional outbox dispatch, scoped job identity, and idempotent callbacks prevent duplicate or stale results from overwriting accepted state.</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:bg-sky-500"><strong class="text-[var(--text-base)]">Authorization and evidence</strong> — protect project-scoped retrieval and agent traces at their owning API/gateway boundaries, keeping provider credentials separate from persisted evidence.</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:bg-sky-500"><strong class="text-[var(--text-base)]">Deployment boundaries</strong> — compose-managed private networks keep domain databases and caches separate from application and public ingress planes.</li>
          </ul>
        </section>

        <!-- Stack & infra -->
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Stack &amp; infrastructure</h2>
          <h3 class="text-2xl font-bold text-[var(--text-base)] mb-6">Applied AI technology stack.</h3>
          <ul class="space-y-4 text-[var(--text-muted)] mb-6">
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Agent Orchestration & AI</strong> — LangGraph, LangChain, Model Context Protocol (MCP), LiteLLM, Qdrant Vector DB, Ollama</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Observability & Evaluation</strong> — OpenTelemetry (OTel), OTLP Ingest, LLM-as-a-Judge, Langfuse, Deterministic Quality Gates</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Backend & Workers</strong> — Python, FastAPI, Celery, Redis, PostgreSQL, MongoDB, Pydantic, SQLAlchemy</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Documents & Storage</strong> — Docling OCR & Layout Engine, MinIO S3 Object Storage</li>
            <li class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2.5 before:w-1.5 before:h-1.5 before:rounded-full before:bg-sky-500"><strong class="text-[var(--text-base)]">Frontend & Tooling</strong> — React 19, Vite, Tailwind CSS, Playwright, Docker, Docker Compose, Nginx</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Stack</h2>
          <div class="flex flex-wrap gap-2 mt-4">
            {item.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </section>
      </article>

      <aside class="case-aside">
        <div class="evidence-card">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Role</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">{item.role}</p>
        </div>
        <div class="evidence-card">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Evidence</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">{item.outcome}</p>
        </div>
        <div class="evidence-card">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Capabilities</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-4"><strong class="text-[var(--text-base)]">Knowledge Builder</strong> — Docling/OCR, recoverable versioned processing, PostgreSQL–Qdrant hybrid retrieval, and LangGraph agents with frozen answer evidence</p>
          <p class="text-[var(--text-muted)] leading-relaxed mb-4"><strong class="text-[var(--text-base)]">Agent Assurance</strong> — versioned Scenarios and qualified Runs, HTTP/OTLP evidence, explicit quality gates, and the measured First Run First workflow</p>
          <p class="text-[var(--text-muted)] leading-relaxed mb-4"><strong class="text-[var(--text-base)]">Platform Control Plane</strong> — FastAPI project identity and authorization, with independent Knowledge Builder and Agent Assurance services, persistence and workers</p>
        </div>
        <div class="evidence-card">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 mb-4">Shape</h3>
          <p class="text-[var(--text-muted)] leading-relaxed mb-6">Multi-service Python monorepo with independently deployable applications and shared typed contracts</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
