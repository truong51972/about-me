---
import { withBase } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cases } from "../../data/profile";
const item = cases.find((caseItem) => caseItem.slug === "banking-automation")!;
---
<BaseLayout title="Banking QA Automation" description="Banking QA automation case study." >
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="case-hero-meta">
        <div class="case-index">{item.label}</div>
        {item.period && <div class="case-period">{item.period}</div>}
      </div>
      <h1>Banking QA automation across Core Banking and Payment Hub.</h1>
      <p class="page-summary">{item.summary}</p>
      <div class="hero-actions">
        <a class="btn ghost" href={withBase("projects/")}>Back to projects</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container content-grid">
      <article class="article">
        <section class="block">
          <div class="eyebrow">Problem</div>
          <h2>Banking QA creates strong constraints for automation.</h2>
          <p>Unlike toy QA examples, banking workflows involve transaction correctness, regression coverage, multiple channels, auditability, API contracts, database state, and failure classification.</p>
        </section>

        <section class="block">
          <div class="eyebrow">What I built</div>
          <h2>Core Banking PoC and Payment Hub integration testing.</h2>
          <p>The Core Banking automation proof of concept covered Web, iOS, and Android automation, supporting a successful automation proposal across channels.</p>
          <p>The Payment Hub work involved Postman API testing, SQL validation, regression testing, and JMeter stress testing. Internal delivery metrics are treated as verified but private, so this public case study emphasizes the engineering scope rather than headline numbers.</p>
          <p>This QA automation experience is the practical foundation behind the <strong>Agent Testing (ATA)</strong> direction in Omni-Agent — applying structured evaluation, regression reporting, and QA discipline to AI agent and RAG workflows.</p>
        </section>

        <section class="block">
          <div class="eyebrow">Key highlights</div>
          <ul class="clean clean-flush">
            {item.highlights.map((h) => <li>{h}</li>)}
          </ul>
          <p class="block-note"><strong>Outcome:</strong> {item.outcome}</p>
        </section>

        <section class="block">
          <div class="eyebrow">Stack</div>
          <div class="tag-row">
            {item.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </section>
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h3>Evidence</h3>
          <p>{item.outcome}</p>
        </div>
        <div class="side-card">
          <h3>Role</h3>
          <p>{item.role}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
